{
  "name": "golden-valley-guns",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  "r2_buckets": [
    {
      "bucket_name": "golden-valley-guns-images",
      "binding": "DISTRIBUTOR_IMAGES"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "7dd7a106dd81433cbd73dcbebb3727e5"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://tyqgvpiunplgqzkygnii.supabase.co",
    "SITE_HOSTNAME": "goldenvalleygunsllc.com",
    // "sandbox" or "production" - switches both the Authorize.net API endpoint
    // (src/lib/authorizeNet.js) and which Accept.js script checkout.html loads.
    // Flip to "production" only once real (non-sandbox) API credentials are set below.
    "AUTHORIZENET_ENVIRONMENT": "sandbox"
  }
  // Secrets (not stored here - set via `wrangler secret put NAME`):
  //   SUPABASE_SERVICE_ROLE_KEY     - already set (Project Settings > API > service_role)
  //   LIPSEYS_EMAIL / LIPSEYS_PASSWORD - already set
  //   AUTHORIZENET_API_LOGIN_ID     - not set yet, needs Shawn's Authorize.net merchant account
  //   AUTHORIZENET_TRANSACTION_KEY  - not set yet, generated alongside the API Login ID
  // See src/lib/authorizeNet.js and js/checkout-config.js for how these are used.
}
