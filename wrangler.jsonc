{
  "name": "golden-valley-guns",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Without this, Cloudflare serves static files straight from its edge
    // cache and skips invoking src/worker.js entirely for anything that
    // matches a real file - meaning fetch()'s security-header wrapping
    // (src/lib/securityHeaders.js) would silently never run for actual
    // page requests, only for routes like /api/checkout that aren't real
    // files. Confirmed empirically 2026-07-18: headers showed up on
    // /api/checkout but not on /shop.html until this was added.
    "run_worker_first": true
  },
  "triggers": {
    // "0 */4 * * *"  - full distributor catalog sync (all SYNC_JOBS), 6x/day.
    //                  Widened from once daily 2026-07-20: at 1500 raw items/run
    //                  (CHUNK_SIZE in sync/lipseys.js - see that file for why),
    //                  once daily meant ~13 days to walk the full ~19,000-item
    //                  catalog and unlock every row's image_source_name for
    //                  backfillLipseysImages to act on. 6x/day cuts that to ~2
    //                  days without changing the safe per-run chunk size.
    // "*/10 * * * *" - Lipsey's + Orion image backfill only, see
    //                  IMAGE_BACKFILL_CRON in src/worker.js for why this
    //                  needs its own frequent schedule instead of waiting
    //                  on the catalog sync
    // Orion catalog sync ("15 */4 * * *", src/worker.js ORION_SYNC_CRON) is
    // PAUSED as of 2026-07-24 - not registered here, not running. Working
    // code + a live-verified subrequest-limit fix both exist (see
    // sync/orion.js), but only Orion's public *website* Terms of Use has
    // been checked so far, not the actual dealer/API agreement (unlike
    // Lipsey's, where that agreement was read in full before going live and
    // turned up real, specific requirements - IP/domain pre-approval, no
    // image hotlinking - that a generic ToS wouldn't have shown). Re-add
    // "15 */4 * * *" to this array once that's actually been reviewed.
    // ~1,386 real Orion products already synced during testing are left in
    // place (verified: dealer cost never exposed, images already cached to
    // our own R2 not hotlinked, MAP price floor already honored) - this
    // pause only stops it from syncing further, not a rollback.
    "crons": ["0 */4 * * *", "*/10 * * * *"]
  },
  "r2_buckets": [
    {
      "bucket_name": "golden-valley-guns-images",
      "binding": "DISTRIBUTOR_IMAGES"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "7dd7a106dd81433cbd73dcbebb3727e5"
    }
  ],
  // Contact form submissions send here directly - no third-party form
  // service (Formspree's placeholder ID was never replaced, meaning the
  // entire site's lead-generation path silently/visibly failed until this).
  // Cloudflare Email Routing enabled on the zone 2026-07-18, destination
  // already verified since it's the same email used to log into Cloudflare.
  //
  // 2026-07-20: dropped the destination_address restriction (was locked to
  // just goldenvalleyguns@gmail.com) so this binding can also send order
  // confirmations and build-status updates to arbitrary customer addresses,
  // not just Shawn's inbox - see src/lib/email.js. Requires the domain to be
  // onboarded for sending under Compute > Email Service > Email Sending in
  // the dashboard (adds SPF/DKIM/DMARC records); without that, sends to any
  // address other than a verified one in the account will fail.
  "send_email": [
    {
      "name": "CONTACT_EMAIL"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://tyqgvpiunplgqzkygnii.supabase.co",
    "SITE_HOSTNAME": "goldenvalleygunsllc.com",
    // "sandbox" or "production" - switches both the Authorize.net API endpoint
    // (src/lib/authorizeNet.js) and which Accept.js script checkout.html loads.
    // Set to "production" 2026-07-18: real (non-sandbox) API credentials are in use
    // below. Authorize.net's own Transaction Processing Mode is still "Not enabled"
    // pending their merchant account approval, so no real charge can complete yet
    // even though this points at the live endpoint - safe to leave as-is until they approve.
    "AUTHORIZENET_ENVIRONMENT": "production"
  }
  // Secrets (not stored here - set via `wrangler secret put NAME`):
  //   SUPABASE_SERVICE_ROLE_KEY     - already set (Project Settings > API > service_role)
  //   LIPSEYS_EMAIL / LIPSEYS_PASSWORD - already set
  //   LIPSEYS_RELAY_URL / LIPSEYS_RELAY_SECRET - already set (relay/ - see src/sync/lipseys.js)
  //   AUTHORIZENET_API_LOGIN_ID     - set 2026-07-18
  //   AUTHORIZENET_TRANSACTION_KEY  - set 2026-07-18
  // See src/lib/authorizeNet.js and js/checkout-config.js for how these are used.
}
