{
  "name": "golden-valley-guns",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Without this, Cloudflare serves static files straight from its edge
    // cache and skips invoking src/worker.js entirely for anything that
    // matches a real file - meaning fetch()'s security-header wrapping
    // (src/lib/securityHeaders.js) would silently never run for actual
    // page requests, only for routes like /api/checkout that aren't real
    // files. Confirmed empirically 2026-07-18: headers showed up on
    // /api/checkout but not on /shop.html until this was added.
    "run_worker_first": true
  },
  "triggers": {
    // "0 */4 * * *"  - full distributor catalog sync (all SYNC_JOBS: Lipsey's,
    //                  RSR), 6x/day. Widened from once daily 2026-07-20: at
    //                  1500 raw items/run (CHUNK_SIZE in sync/lipseys.js - see
    //                  that file for why), once daily meant ~13 days to walk
    //                  the full ~19,000-item catalog and unlock every row's
    //                  image_source_name for backfillLipseysImages to act on.
    //                  6x/day cuts that to ~2 days without changing the safe
    //                  per-run chunk size. Davidson's moved off this shared
    //                  cron 2026-08-07 - see "*/20 * * * *" below.
    // "*/10 * * * *" - Lipsey's + Orion image backfill only, see
    //                  IMAGE_BACKFILL_CRON in src/worker.js for why this
    //                  needs its own frequent schedule instead of waiting
    //                  on the catalog sync
    // "15 */4 * * *"  - Orion catalog sync (src/worker.js ORION_SYNC_CRON).
    //                  Was paused 2026-07-24 to 2026-07-28 pending review of
    //                  the actual Orion dealer/API agreement (not just the
    //                  public website Terms of Use) - confirmed reviewed
    //                  2026-07-28, re-enabled. ~1,386 real Orion products
    //                  already synced during the original testing were left
    //                  in place the whole time (dealer cost never exposed,
    //                  images cached to our own R2, MAP price floor already
    //                  honored) - this cron resumes syncing further, not a
    //                  fresh start. catalog_manufacturers is a SHARED
    //                  allow-list across every distributor, so Orion will
    //                  now match against the full widened brand list (see
    //                  src/lib/catalogSync.js), not just the handful it
    //                  happened to share with Lipsey's during testing.
    // "*/20 * * * *"  - Davidson's catalog sync (src/worker.js
    //                  DAVIDSONS_SYNC_CRON), split off the shared 0 */4 * * *
    //                  cron 2026-08-07 after adding Davidson's there pushed
    //                  that invocation's combined subrequest count over
    //                  Cloudflare's per-invocation limit (see
    //                  src/lib/imageCache.js/src/sync/lipseys.js history for
    //                  the incident). Runs far more often than Orion's 4-hour
    //                  cadence because Davidson's per-chunk work is cheap
    //                  once a cycle's raw CSV is cached - no external
    //                  distributor request at all except on the run that
    //                  starts a new cycle (see CATALOG_CACHE_KEY in
    //                  sync/davidsons.js). At CHUNK_SIZE=1500 against a
    //                  ~10,550-row catalog (~7 runs/cycle), 20 minutes means
    //                  a full cycle finishes in ~2.3 hours instead of the
    //                  ~28 hours it took sharing the 4-hour cron.
    "crons": ["0 */4 * * *", "*/10 * * * *", "15 */4 * * *", "*/20 * * * *"]
  },
  "r2_buckets": [
    {
      "bucket_name": "golden-valley-guns-images",
      "binding": "DISTRIBUTOR_IMAGES"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "7dd7a106dd81433cbd73dcbebb3727e5"
    }
  ],
  // No send_email binding here anymore - all outbound mail (contact form,
  // order/build/intake confirmations) switched to Resend's HTTP API
  // 2026-08-06 (see src/lib/email.js) because Cloudflare Email Routing's
  // send_email binding could only deliver to a destination address already
  // verified in the Cloudflare account, meaning it could never actually
  // reach real customers. RESEND_API_KEY is set via `wrangler secret put`.
  "vars": {
    "SUPABASE_URL": "https://tyqgvpiunplgqzkygnii.supabase.co",
    "SITE_HOSTNAME": "goldenvalleygunsllc.com",
    // "sandbox" or "production" - switches both the Authorize.net API endpoint
    // (src/lib/authorizeNet.js) and which Accept.js script checkout.html loads.
    // Set to "production" 2026-07-18: real (non-sandbox) API credentials are in use
    // below. Authorize.net's own Transaction Processing Mode is still "Not enabled"
    // pending their merchant account approval, so no real charge can complete yet
    // even though this points at the live endpoint - safe to leave as-is until they approve.
    "AUTHORIZENET_ENVIRONMENT": "production"
  }
  // Secrets (not stored here - set via `wrangler secret put NAME`):
  //   SUPABASE_SERVICE_ROLE_KEY     - already set (Project Settings > API > service_role)
  //   LIPSEYS_EMAIL / LIPSEYS_PASSWORD - already set
  //   LIPSEYS_RELAY_URL / LIPSEYS_RELAY_SECRET - already set (relay/ - see src/sync/lipseys.js)
  //   AUTHORIZENET_API_LOGIN_ID     - set 2026-07-18
  //   AUTHORIZENET_TRANSACTION_KEY  - set 2026-07-18
  //   DAVIDSONS_USERNAME / DAVIDSONS_PASSWORD - set 2026-08-07 (dealer portal login, no separate API key - see src/sync/davidsons.js)
  // See src/lib/authorizeNet.js and js/checkout-config.js for how these are used.
}
